<Window x:Class="GamingLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:GamingLauncher.ViewModels"
        xmlns:views="clr-namespace:GamingLauncher.Views"
        xmlns:controls="clr-namespace:GamingLauncher.Controls"
        Title="PACMAN Gaming Cafe"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowState="Maximized"
        ShowInTaskbar="False"
        Background="{StaticResource Brush.Surface}"
        FontFamily="{StaticResource Font.Ui}">

    <Window.InputBindings>
        <KeyBinding Modifiers="Control+Shift" Key="S" Command="{Binding OpenSuperadminCommand}" />
    </Window.InputBindings>

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:GamesViewModel}">
            <views:GameGridView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:FoodViewModel}">
            <views:FoodOrderView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SessionInfoViewModel}">
            <views:SessionInfoView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:GamingModeViewModel}">
            <views:GamingModeView />
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource Brush.SurfaceRaised}"
                BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,0,0,1"
                Padding="32,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Pacman" FontFamily="{StaticResource Font.Display}" FontSize="20"
                               Foreground="{StaticResource Brush.Accent}" VerticalAlignment="Center" />
                    <TextBlock Text=" Gaming Cafe" FontFamily="{StaticResource Font.Display}" FontSize="20"
                               Foreground="{StaticResource Brush.Text}" VerticalAlignment="Center" />
                    <Border Background="{StaticResource Brush.Panel}"
                            BorderBrush="{StaticResource Brush.Border}"
                            BorderThickness="1" CornerRadius="6" Padding="8,4" Margin="16,0,0,0">
                        <TextBlock Text="{Binding PcName}" Foreground="{StaticResource Brush.TextMuted}"
                                   FontSize="13" />
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Button Content="Games" Command="{Binding OpenGamesCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavTabButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsGamesSelected}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource Brush.Panel}" />
                                        <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="Food" Command="{Binding OpenFoodCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavTabButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsFoodSelected}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource Brush.Panel}" />
                                        <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="Session" Command="{Binding OpenSessionInfoCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavTabButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSessionInfoSelected}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource Brush.Panel}" />
                                        <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>

                <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <TextBlock Text="Time remaining" FontSize="12"
                               Foreground="{StaticResource Brush.TextFaint}"
                               HorizontalAlignment="Right" />
                    <TextBlock Text="{Binding RemainingText}"
                               FontFamily="{StaticResource Font.Mono}"
                               FontSize="28" FontWeight="Normal"
                               Foreground="{Binding TimerColor}"
                               HorizontalAlignment="Right" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <controls:CrossfadeContentControl Content="{Binding CurrentView}"
                                                ContentKey="{Binding ContentSwitchKey}" />

            <Border VerticalAlignment="Top" Margin="0,12,0,0"
                    Visibility="{Binding SessionAlertText, Converter={StaticResource StringToVisibility}}"
                    Background="{StaticResource Brush.Panel}"
                    BorderBrush="{StaticResource Brush.Border}"
                    BorderThickness="1"
                    CornerRadius="8" Padding="16,10"
                    HorizontalAlignment="Center">
                <TextBlock Text="{Binding SessionAlertText}"
                           Foreground="{Binding SessionAlertColor}"
                           FontSize="14" />
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="{StaticResource Brush.SurfaceRaised}"
                BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,1,0,0"
                Padding="32,10">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="7" Height="7" Margin="0,0,8,0">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{StaticResource Brush.Danger}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding AgentConnected}" Value="True">
                                        <Setter Property="Fill" Value="{StaticResource Brush.Accent}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="{Binding AgentStatusText}"
                               Foreground="{StaticResource Brush.TextMuted}" FontSize="13" />
                </StackPanel>

                <TextBlock Text="Ctrl+Shift+S for staff"
                           Foreground="{StaticResource Brush.TextFaint}" FontSize="12"
                           HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <Grid Grid.RowSpan="3"
              Visibility="{Binding Superadmin.IsVisible, Converter={StaticResource BoolToVisibility}}">
            <Rectangle Fill="{StaticResource Brush.Overlay}" />
            <Border Width="560" MaxHeight="720" Style="{StaticResource PanelCard}"
                    VerticalAlignment="Center" HorizontalAlignment="Center" Padding="0">
                <ScrollViewer Padding="28">
                <StackPanel>
                    <TextBlock Text="Staff access" Style="{StaticResource PageTitle}"
                               FontSize="22" Margin="0,0,0,4" />
                    <TextBlock Text="Maintenance actions are logged." Style="{StaticResource PageSubtitle}"
                               Margin="0,0,0,20" />

                    <TextBlock Text="Password" Foreground="{StaticResource Brush.TextMuted}"
                               FontSize="13" Margin="0,0,0,6" />
                    <PasswordBox x:Name="SuperadminPasswordBox" FontSize="15" Padding="10,8"
                                 Background="{StaticResource Brush.Surface}"
                                 Foreground="{StaticResource Brush.Text}"
                                 BorderBrush="{StaticResource Brush.Border}" />

                    <TextBlock Text="{Binding Superadmin.ErrorMessage}" Foreground="{StaticResource Brush.Danger}"
                               FontSize="13" Margin="0,10,0,0" TextWrapping="Wrap" />

                    <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                        <Button Content="Unlock" Style="{StaticResource PrimaryButton}"
                                Click="SuperadminEnter_Click" />
                        <Button Content="Cancel" Style="{StaticResource SecondaryButton}"
                                Command="{Binding Superadmin.CancelCommand}" Margin="10,0,0,0" />
                    </StackPanel>

                    <StackPanel Visibility="{Binding Superadmin.Unlocked, Converter={StaticResource BoolToVisibility}}"
                                Margin="0,20,0,0">
                        <TextBlock Text="Maintenance" Style="{StaticResource SectionLabel}" Margin="0,0,0,8" />
                        <Button Content="Enter Windows desktop" Command="{Binding Superadmin.EnterWindowsCommand}"
                                Style="{StaticResource MaintenanceButton}" />
                        <Button Content="Restart PC" Command="{Binding Superadmin.RestartCommand}"
                                Style="{StaticResource MaintenanceButton}" />
                        <Button Content="Shutdown PC" Command="{Binding Superadmin.ShutdownCommand}"
                                Style="{StaticResource MaintenanceButton}" />
                        <TextBlock Text="Game library (this PC)" Style="{StaticResource SectionLabel}"
                                   Margin="0,18,0,8" />
                        <Button Content="Scan PC for installed games"
                                Command="{Binding Superadmin.ScanGamesCommand}"
                                Style="{StaticResource MaintenanceButton}" />
                        <Button Content="Add from shortcut or .exe…"
                                Command="{Binding Superadmin.AddShortcutCommand}"
                                Style="{StaticResource MaintenanceButton}" />
                        <TextBlock Text="On this PC" Style="{StaticResource SectionLabel}" Margin="0,14,0,6" />
                        <TextBlock Text="No games in library yet."
                                   Foreground="{StaticResource Brush.TextFaint}" FontSize="13"
                                   Margin="0,0,0,8"
                                   Visibility="{Binding Superadmin.HasLibraryItems, Converter={StaticResource InverseBoolToVisibility}}" />
                        <ItemsControl ItemsSource="{Binding Superadmin.Library}" Margin="0,0,0,8">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,10">
                                        <TextBlock Text="{Binding Name}" FontFamily="{StaticResource Font.Display}"
                                                   Foreground="{StaticResource Brush.Text}" FontSize="14" />
                                        <TextBlock Text="{Binding ExecutablePath}" FontSize="11"
                                                   Foreground="{StaticResource Brush.TextFaint}"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding ExecutablePath}" Margin="0,2,0,0" />
                                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                            <Button Content="Path" Style="{StaticResource SecondaryButton}"
                                                    Padding="8,4" FontSize="11" Margin="0,0,6,0"
                                                    Command="{Binding DataContext.Superadmin.SetPathCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}" />
                                            <Button Content="Thumbnail" Style="{StaticResource SecondaryButton}"
                                                    Padding="8,4" FontSize="11" Margin="0,0,6,0"
                                                    Command="{Binding DataContext.Superadmin.UploadThumbnailCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}" />
                                            <Button Content="Remove" Style="{StaticResource SecondaryButton}"
                                                    Padding="8,4" FontSize="11"
                                                    Command="{Binding DataContext.Superadmin.RemoveGameCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}" />
                                        </StackPanel>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{Binding Superadmin.GamesStatus}" Foreground="{StaticResource Brush.TextMuted}"
                                   FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap" />
                        <Button Content="Close panel" Command="{Binding Superadmin.ExitSuperadminCommand}"
                                Style="{StaticResource MaintenanceButton}" Margin="0,16,0,0" />
                    </StackPanel>
                </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Window>
