<UserControl x:Class="GamingLauncher.Views.FoodOrderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="36,28,36,20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="400" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Margin="0,0,28,0">
            <TextBlock Text="CAFÉ MENU" FontFamily="{StaticResource Font.Display}"
                       FontSize="28" FontWeight="Bold"
                       Foreground="{StaticResource Brush.Text}" />
            <TextBlock Text="Fuel up without leaving your station."
                       FontSize="15" Foreground="{StaticResource Brush.TextMuted}"
                       Margin="0,6,0,22" />

            <ItemsControl ItemsSource="{Binding Menu}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource PanelCard}" Margin="0,0,0,12" Padding="18,14">
                            <Grid>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" Foreground="{StaticResource Brush.Text}"
                                               FontSize="18" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding PriceText}" Foreground="{StaticResource Brush.Accent}"
                                               FontSize="15" Margin="0,4,0,0" />
                                </StackPanel>
                                <Button Content="Add" HorizontalAlignment="Right" VerticalAlignment="Center"
                                        Command="{Binding DataContext.AddToCart, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        Style="{StaticResource PrimaryButton}"
                                        Padding="18,8" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <Border Grid.Column="1" Style="{StaticResource PanelCard}" VerticalAlignment="Stretch">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16">
                    <TextBlock Text="Your order" FontFamily="{StaticResource Font.Display}"
                               Foreground="{StaticResource Brush.Text}"
                               FontSize="22" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource Brush.TextMuted}"
                               FontSize="14" Margin="0,8,0,0" TextWrapping="Wrap"
                               Visibility="{Binding StatusText, Converter={StaticResource StringToVisibility}}" />
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom" Margin="0,16,0,0">
                    <Grid Margin="0,0,0,14">
                        <TextBlock Text="Total" Foreground="{StaticResource Brush.TextMuted}"
                                   FontSize="16" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding TotalText}" Foreground="{StaticResource Brush.Text}"
                                   FontSize="24" FontWeight="Bold"
                                   HorizontalAlignment="Right" />
                    </Grid>
                    <Button Content="Place order" Command="{Binding PlaceOrder}"
                            Style="{StaticResource PrimaryButton}"
                            HorizontalAlignment="Stretch" Padding="0,14" />
                    <Button Content="Back to games"
                            Command="{Binding DataContext.BackToGamesCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            Style="{StaticResource SecondaryButton}"
                            HorizontalAlignment="Stretch" Margin="0,10,0,0" />
                </StackPanel>

                <Border Background="{StaticResource Brush.Surface}" CornerRadius="10"
                        BorderBrush="{StaticResource Brush.Border}" BorderThickness="1"
                        Padding="8" MinHeight="180">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="Cart is empty — add something from the menu."
                                       Foreground="{StaticResource Brush.TextFaint}"
                                       FontSize="14" TextAlignment="Center"
                                       Margin="12,24"
                                       Visibility="{Binding HasCartItems, Converter={StaticResource InverseBoolToVisibility}}" />
                            <ItemsControl ItemsSource="{Binding Cart}"
                                          Visibility="{Binding HasCartItems, Converter={StaticResource BoolToVisibility}}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource Brush.Panel}"
                                                CornerRadius="10" Padding="12,10" Margin="0,0,0,8">
                                            <Grid>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" Foreground="{StaticResource Brush.Text}"
                                                               FontSize="15" Width="140" VerticalAlignment="Center"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <Button Content="−" Command="{Binding DataContext.DecrementQty, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}" Width="34" Height="34"
                                                            Style="{StaticResource SecondaryButton}" Padding="0" />
                                                    <TextBlock Text="{Binding Qty}" Foreground="{StaticResource Brush.Text}"
                                                               FontSize="15" Width="32" TextAlignment="Center"
                                                               VerticalAlignment="Center" />
                                                    <Button Content="+" Command="{Binding DataContext.IncrementQty, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}" Width="34" Height="34"
                                                            Style="{StaticResource PrimaryButton}" Padding="0" />
                                                </StackPanel>
                                                <TextBlock Text="{Binding LineTotalText}"
                                                           Foreground="{StaticResource Brush.Accent}"
                                                           FontSize="15" FontWeight="SemiBold"
                                                           HorizontalAlignment="Right"
                                                           VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
