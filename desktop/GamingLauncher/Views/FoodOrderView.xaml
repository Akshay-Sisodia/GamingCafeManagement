<UserControl x:Class="GamingLauncher.Views.FoodOrderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="40,24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="420" />
        </Grid.ColumnDefinitions>

        <!-- Menu -->
        <TextBlock Text="FOOD MENU" Foreground="#9CA3AF" FontSize="20" FontWeight="SemiBold" />
        <ItemsControl Grid.Column="0" ItemsSource="{Binding Food.Menu}" Margin="0,44,24,0">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Background="#111827" CornerRadius="8" Padding="18,12" Margin="0,0,0,10">
                        <Grid>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Name}" Foreground="#F9FAFB" FontSize="18"
                                           VerticalAlignment="Center" Width="220" />
                                <TextBlock Text="{Binding PriceText}" Foreground="#10B981" FontSize="18"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                            <Button Content="ADD" HorizontalAlignment="Right"
                                    Command="{Binding DataContext.Food.AddToCart, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}"
                                    Background="#10B981" Foreground="#06281F" FontWeight="Bold"
                                    Padding="20,6" BorderThickness="0" Cursor="Hand" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Cart -->
        <Border Grid.Column="1" Background="#111827" CornerRadius="10" Padding="22"
                VerticalAlignment="Stretch" Margin="0,44,0,0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="YOUR ORDER" Foreground="#F9FAFB"
                           FontSize="18" FontWeight="SemiBold" Margin="0,0,0,14" />

                <StackPanel DockPanel.Dock="Bottom">
                    <TextBlock Text="{Binding Food.StatusText}" Foreground="#9CA3AF"
                               FontSize="14" Margin="0,8,0,0" TextWrapping="Wrap" />
                    <Grid Margin="0,10,0,14">
                        <TextBlock Text="TOTAL" Foreground="#9CA3AF" FontSize="18" HorizontalAlignment="Left" />
                        <TextBlock Text="{Binding Food.TotalText}" Foreground="#F9FAFB" FontSize="22"
                                   FontWeight="Bold" HorizontalAlignment="Right" />
                    </Grid>
                    <Button Content="PLACE ORDER" Command="{Binding Food.PlaceOrder}"
                            Background="#10B981" Foreground="#06281F" FontSize="18" FontWeight="Bold"
                            Padding="0,14" BorderThickness="0" Cursor="Hand" />
                </StackPanel>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Food.Cart}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#0B0F0E" CornerRadius="6" Padding="12,8" Margin="0,0,0,8">
                                    <Grid>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" Foreground="#F9FAFB"
                                                       FontSize="16" Width="150" VerticalAlignment="Center" />
                                            <Button Content="-" Command="{Binding DataContext.Food.DecrementQty, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}" Width="34" Height="34"
                                                    Background="#374151" Foreground="#F9FAFB" BorderThickness="0" Cursor="Hand" />
                                            <TextBlock Text="{Binding Qty}" Foreground="#F9FAFB" FontSize="16"
                                                       Width="36" TextAlignment="Center" VerticalAlignment="Center" />
                                            <Button Content="+" Command="{Binding DataContext.Food.IncrementQty, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}" Width="34" Height="34"
                                                    Background="#10B981" Foreground="#06281F" BorderThickness="0" Cursor="Hand" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding LineTotalText}" Foreground="#10B981"
                                                   FontSize="16" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
