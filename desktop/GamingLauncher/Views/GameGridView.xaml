<UserControl x:Class="GamingLauncher.Views.GameGridView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="32,24,32,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="4,0,4,20">
            <TextBlock Text="GAME LIBRARY" FontFamily="{StaticResource Font.Display}"
                       FontSize="28" FontWeight="Bold"
                       Foreground="{StaticResource Brush.Text}" />
            <TextBlock Text="Pick your title — neon's on, timer's running."
                       FontSize="15" Foreground="{StaticResource Brush.TextMuted}" Margin="0,6,0,0" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Items}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="5" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Command="{Binding DataContext.LaunchCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}"
                                Style="{StaticResource GamePosterButton}"
                                Width="220" Height="300" Margin="10">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0" ClipToBounds="True">
                                    <Border Background="{Binding FallbackBrush}" />
                                    <Image Source="{Binding CoverImage}" Stretch="UniformToFill"
                                           Visibility="{Binding HasCoverImage, Converter={StaticResource BoolToVisibility}}" />
                                    <Border Background="#6606070D" />
                                    <TextBlock Text="{Binding Initial}" FontFamily="{StaticResource Font.Display}"
                                               FontSize="48" FontWeight="Bold"
                                               Foreground="#80FFFFFF"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Visibility="{Binding HasCoverImage, Converter={StaticResource InverseBoolToVisibility}}" />
                                </Grid>

                                <Border Grid.Row="1" Background="{StaticResource Brush.SurfaceRaised}"
                                        Padding="14,12">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontFamily="{StaticResource Font.Display}"
                                                   FontSize="17" FontWeight="Bold"
                                                   Foreground="{StaticResource Brush.Text}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <Border Style="{StaticResource CategoryBadge}" Margin="0,8,0,0"
                                                HorizontalAlignment="Left">
                                            <TextBlock Text="{Binding Category}" FontSize="11" FontWeight="Bold"
                                                       Foreground="{StaticResource Brush.Accent}" />
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
