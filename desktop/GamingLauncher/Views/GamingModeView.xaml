<UserControl x:Class="GamingLauncher.Views.GamingModeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Storyboard x:Key="PulseGlow" RepeatBehavior="Forever" AutoReverse="True">
            <DoubleAnimation Storyboard.TargetName="GlowRing"
                             Storyboard.TargetProperty="Opacity"
                             From="0.35" To="0.85" Duration="0:0:1.2" />
        </Storyboard>
    </UserControl.Resources>
    <UserControl.Triggers>
        <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard Storyboard="{StaticResource PulseGlow}" />
        </EventTrigger>
    </UserControl.Triggers>

    <Grid>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="560">
            <Grid Width="120" Height="120" Margin="0,0,0,24">
                <Ellipse x:Name="GlowRing" Fill="{StaticResource Brush.NeonGlow}" Opacity="0.5" />
                <Border Width="88" Height="88" CornerRadius="44"
                        Background="{StaticResource Brush.AccentMuted}"
                        BorderBrush="{StaticResource Brush.AccentStrong}"
                        BorderThickness="2"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="▶" FontSize="36" Foreground="{StaticResource Brush.Accent}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Margin="6,0,0,0" />
                </Border>
            </Grid>

            <TextBlock Text="IN THE ZONE"
                       FontFamily="{StaticResource Font.Display}"
                       FontSize="40" FontWeight="Bold"
                       Foreground="{StaticResource Brush.Text}"
                       HorizontalAlignment="Center" />

            <TextBlock Text="Session time keeps ticking in the header.&#x0a;Exit your game to jump back to the library."
                       FontFamily="{StaticResource Font.Ui}"
                       FontSize="16" LineHeight="24"
                       Foreground="{StaticResource Brush.TextMuted}"
                       TextAlignment="Center" TextWrapping="Wrap"
                       Margin="0,12,0,28" />

            <Button Content="Back to game library"
                    Command="{Binding DataContext.BackToGamesCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                    Style="{StaticResource SecondaryButton}"
                    HorizontalAlignment="Center" />
        </StackPanel>
    </Grid>
</UserControl>
