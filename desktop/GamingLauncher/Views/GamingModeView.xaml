<UserControl x:Class="GamingLauncher.Views.GamingModeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="480">
            <Border Width="64" Height="64" CornerRadius="32"
                    Background="{StaticResource Brush.Panel}"
                    BorderBrush="{StaticResource Brush.Border}"
                    BorderThickness="1"
                    HorizontalAlignment="Center" Margin="0,0,0,20">
                <TextBlock Text="▶" FontSize="22" Foreground="{StaticResource Brush.Accent}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Margin="4,0,0,0" />
            </Border>

            <TextBlock Text="Game running" Style="{StaticResource PageTitle}" FontSize="24"
                       HorizontalAlignment="Center" />

            <TextBlock Text="Your session timer is in the header. Close the game to return to the library."
                       Style="{StaticResource PageSubtitle}" LineHeight="22"
                       TextAlignment="Center" TextWrapping="Wrap"
                       Margin="0,10,0,24" />

            <Button Content="Back to library"
                    Command="{Binding DataContext.BackToGamesCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                    Style="{StaticResource SecondaryButton}"
                    HorizontalAlignment="Center" />
        </StackPanel>
    </Grid>
</UserControl>
