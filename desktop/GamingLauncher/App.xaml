<Application x:Class="GamingLauncher.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:GamingLauncher"
             Startup="OnStartup">
    <Application.Resources>
        <local:StringToVisibilityConverter x:Key="StringToVisibility" />
        <local:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <local:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility" />
    </Application.Resources>
</Application>
